<Window x:Class="MonitorInspector.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="显示器读取器" Width="1100" Height="760" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#182234" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#182234"/><Setter Property="BorderBrush" Value="#D8DEE8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E9EFFB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#D4E1F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7B8596"/><Setter TargetName="B" Property="Background" Value="#EEF0F4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/><Setter Property="Foreground" Value="#182234"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/><Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE8FC"/><Setter Property="Foreground" Value="#122D58"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF3F8"/><Setter Property="Foreground" Value="#46546A"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="显示器查看器" FontSize="26" FontWeight="SemiBold"/><TextBlock Margin="0,6,0,0" Foreground="#56657A" Text="识别当前连接的显示器，查看它公开的功能与数值。"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="MonitorPicker" MinHeight="38" Padding="8,4" SelectionChanged="SelectionChanged" ToolTip="选择当前连接的显示器"/><Button Grid.Column="1" x:Name="RefreshButton" Margin="12,0,0,0" Content="刷新显示器" Click="RefreshClick"/></Grid>
  <WrapPanel Grid.Row="2" Margin="0,0,0,12"><Button x:Name="ScanButton" Content="读取并比较" Click="ScanClick"/><Button x:Name="CancelButton" Content="停止读取" IsEnabled="False" Click="CancelClick"/><Button x:Name="SaveButton" Content="导出记录（可选）" Click="SaveClick"/></WrapPanel>
  <Grid Grid.Row="3" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="刚才的操作（可选）" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#56657A"/><TextBox x:Name="Operation" Grid.Column="1" Padding="8,6" VerticalContentAlignment="Center" ToolTip="例如：DisplayHDR 切到 HDR Game。读取时自动记入变化记录。"/></Grid>
  <TabControl Grid.Row="4" x:Name="Tabs" BorderBrush="#D8DEE8" Background="White">
   <TabItem Header="基本信息"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="Info" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="White" Padding="20" FontSize="14"/></ScrollViewer></TabItem>
   <TabItem Header="显示器功能"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Padding="16" TextWrapping="Wrap" Foreground="#56657A" Text="声明支持 ≠ 读取成功 ≠ 可以修改。此表只展示声明和读取结果；未知控制码不猜用途。"/>
    <DataGrid Grid.Row="1" x:Name="Features"><DataGrid.Columns>
     <DataGridCheckBoxColumn Header="变化" Binding="{Binding Changed}" Width="55"/><DataGridTextColumn Header="控制码" Binding="{Binding Code}" Width="80"/><DataGridTextColumn Header="功能" Binding="{Binding Name}" Width="180"/>
     <DataGridTextColumn Header="当前值" Binding="{Binding Current}" Width="80"/><DataGridTextColumn Header="最大值" Binding="{Binding Maximum}" Width="80"/>
     <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="220"/><DataGridTextColumn Header="来源" Binding="{Binding Declared}" Width="170"/>
     <DataGridTextColumn Header="声明取值（十六进制）" Binding="{Binding Values}" Width="180"/><DataGridTextColumn Header="解释" Binding="{Binding Interpretation}" Width="260"/>
     <DataGridTextColumn Header="错误码" Binding="{Binding Error}" Width="80"/><DataGridTextColumn Header="物理显示器" Binding="{Binding Physical}" Width="240"/>
    </DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="原始证据"><TextBox x:Name="Raw" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="0" Padding="16" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
   <TabItem Header="变化记录"><TextBox x:Name="Diff" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="20" VerticalScrollBarVisibility="Auto" Text="第一次读取记住当前值；操作显示器后，再点读取。变化会自动记录在内存中。"/></TabItem>
  </TabControl>
  <TextBlock Grid.Row="5" x:Name="Status" Margin="0,14,0,0" Foreground="#56657A" TextWrapping="Wrap" Text="正在识别显示器…"/>
 </Grid>
</Window>
